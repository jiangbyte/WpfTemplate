<UserControl x:Class="WpfTemplate.Views.Pages.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">
    <Border Background="{DynamicResource ApplicationBackgroundBrush}"
            Padding="24">
        <StackPanel>
            <ui:TextBlock FontTypography="Subtitle"
                          FontFamily="{StaticResource AppFontFamily}"
                          Text="{Binding Title}" />
            <ui:TextBlock Margin="0,16,0,0"
                          FontTypography="BodyStrong"
                          FontFamily="{StaticResource AppFontFamily}"
                          Text="{Binding ProductName}" />
            <ui:TextBlock Margin="0,8,0,0"
                          FontFamily="{StaticResource AppFontFamily}"
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                          Text="{Binding Version, StringFormat=版本 {0}}" />
            <ui:TextBlock Margin="0,12,0,0"
                          FontFamily="{StaticResource AppFontFamily}"
                          TextWrapping="Wrap"
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                          Text="{Binding Description}" />
        </StackPanel>
    </Border>
</UserControl>
