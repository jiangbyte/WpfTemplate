<ui:FluentWindow x:Class="WpfTemplate.Views.Auth.ForgotPasswordWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="找回密码"
                 Width="920"
                 Height="560"
                 MinWidth="800"
                 MinHeight="500"
                 WindowStartupLocation="CenterScreen"
                 ResizeMode="CanMinimize"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 FontFamily="{StaticResource AppFontFamily}">
    <Grid>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource AccentFillColorDefaultBrush}">
                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Margin="40">
                    <ui:SymbolIcon Symbol="Key24"
                                   FontSize="48"
                                   Foreground="White"
                                   HorizontalAlignment="Center" />
                    <ui:TextBlock Margin="0,18,0,0"
                                  FontTypography="Title"
                                  FontFamily="{StaticResource AppFontFamily}"
                                  Foreground="White"
                                  HorizontalAlignment="Center"
                                  Text="WpfTemplate" />
                    <ui:TextBlock Margin="0,10,0,0"
                                  FontFamily="{StaticResource AppFontFamily}"
                                  Foreground="#CCFFFFFF"
                                  HorizontalAlignment="Center"
                                  TextAlignment="Center"
                                  TextWrapping="Wrap"
                                  Text="{Binding BrandLead}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Background="{DynamicResource ApplicationBackgroundBrush}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Width="340"
                                Margin="40,48,40,24">
                        <DockPanel LastChildFill="False">
                            <ui:TextBlock FontTypography="Title"
                                          FontFamily="{StaticResource AppFontFamily}"
                                          Text="{Binding Title}" />
                            <ui:HyperlinkButton DockPanel.Dock="Right"
                                                VerticalAlignment="Center"
                                                FontFamily="{StaticResource AppFontFamily}"
                                                Content="返回登录"
                                                Command="{Binding GoLoginCommand}" />
                        </DockPanel>

                        <ui:TextBlock Margin="0,8,0,0"
                                      FontFamily="{StaticResource AppFontFamily}"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                      TextWrapping="Wrap"
                                      Text="{Binding Description}" />

                        <StackPanel Visibility="{Binding SendLinkVisibility}">
                            <ui:TextBox Margin="0,20,0,0"
                                        Height="36"
                                        FontFamily="{StaticResource AppFontFamily}"
                                        PlaceholderText="登录邮箱"
                                        Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Visibility="{Binding ResetVisibility}">
                            <ui:TextBox Margin="0,20,0,0"
                                        Height="36"
                                        FontFamily="{StaticResource AppFontFamily}"
                                        PlaceholderText="粘贴邮件中的重置令牌"
                                        Text="{Binding ResetToken, UpdateSourceTrigger=PropertyChanged}" />
                            <ui:PasswordBox x:Name="PasswordBox"
                                            Margin="0,12,0,0"
                                            Height="36"
                                            FontFamily="{StaticResource AppFontFamily}"
                                            PlaceholderText="新密码"
                                            PasswordChanged="PasswordBox_OnPasswordChanged" />
                            <ui:PasswordBox x:Name="ConfirmPasswordBox"
                                            Margin="0,12,0,0"
                                            Height="36"
                                            FontFamily="{StaticResource AppFontFamily}"
                                            PlaceholderText="确认新密码"
                                            PasswordChanged="ConfirmPasswordBox_OnPasswordChanged" />
                        </StackPanel>

                        <Grid Margin="0,12,0,0" Height="36">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox Grid.Column="0"
                                        Height="36"
                                        FontFamily="{StaticResource AppFontFamily}"
                                        PlaceholderText="请输入图形验证码"
                                        Text="{Binding CaptchaValue, UpdateSourceTrigger=PropertyChanged}" />
                            <ui:Button Grid.Column="2"
                                       Height="36"
                                       MinWidth="108"
                                       Padding="8,0"
                                       Appearance="Secondary"
                                       ToolTip="刷新验证码"
                                       Click="CaptchaImage_OnClick">
                                <Grid>
                                    <Image MaxHeight="28"
                                           Stretch="Uniform"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Source="{Binding CaptchaImage}"
                                           Visibility="{Binding CaptchaImage, Converter={StaticResource NullToVisibility}}" />
                                    <ui:SymbolIcon Symbol="ArrowClockwise24"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding CaptchaImage, Converter={StaticResource NullToCollapsed}}" />
                                </Grid>
                            </ui:Button>
                        </Grid>

                        <ui:InfoBar Margin="0,12,0,0"
                                    IsOpen="True"
                                    IsClosable="False"
                                    Severity="Success"
                                    FontFamily="{StaticResource AppFontFamily}"
                                    Title="{Binding StatusMessage}"
                                    Visibility="{Binding StatusMessage, Converter={StaticResource NullOrEmptyToVisibility}}" />

                        <ui:InfoBar Margin="0,12,0,0"
                                    IsOpen="True"
                                    IsClosable="False"
                                    Severity="Error"
                                    FontFamily="{StaticResource AppFontFamily}"
                                    Title="{Binding ErrorMessage}"
                                    Visibility="{Binding ErrorMessage, Converter={StaticResource NullOrEmptyToVisibility}}" />

                        <ui:Button Margin="0,12,0,0"
                                   Height="36"
                                   HorizontalAlignment="Stretch"
                                   FontFamily="{StaticResource AppFontFamily}"
                                   Appearance="Primary"
                                   Content="{Binding SubmitLabel}"
                                   Command="{Binding SubmitCommand}"
                                   IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBool}}" />

                        <DockPanel Margin="0,12,0,0" LastChildFill="False">
                            <ui:HyperlinkButton FontFamily="{StaticResource AppFontFamily}"
                                                Content="去注册"
                                                Visibility="{Binding SendLinkVisibility}"
                                                Command="{Binding GoRegisterCommand}" />
                            <ui:HyperlinkButton FontFamily="{StaticResource AppFontFamily}"
                                                Content="重新申请链接"
                                                Visibility="{Binding ResetVisibility}"
                                                Command="{Binding SwitchToSendLinkCommand}" />
                            <ui:HyperlinkButton DockPanel.Dock="Right"
                                                FontFamily="{StaticResource AppFontFamily}"
                                                Content="已有重置令牌？"
                                                Visibility="{Binding SendLinkVisibility}"
                                                Command="{Binding SwitchToResetCommand}" />
                        </DockPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <ui:TitleBar VerticalAlignment="Top"
                     Title=""
                     ShowMaximize="False"
                     Background="Transparent"
                     ButtonsBackground="Transparent" />
    </Grid>
</ui:FluentWindow>
