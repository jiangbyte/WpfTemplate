<ui:FluentWindow x:Class="WpfTemplate.Views.Auth.RegisterWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="注册"
                 Width="920"
                 Height="560"
                 MinWidth="800"
                 MinHeight="500"
                 WindowStartupLocation="CenterScreen"
                 ResizeMode="CanMinimize"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 FontFamily="{StaticResource AppFontFamily}">
    <Grid>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource AccentFillColorDefaultBrush}">
                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Margin="40">
                    <ui:SymbolIcon Symbol="PersonAdd24"
                                   FontSize="48"
                                   Foreground="White"
                                   HorizontalAlignment="Center" />
                    <ui:TextBlock Margin="0,18,0,0"
                                  FontTypography="Title"
                                  FontFamily="{StaticResource AppFontFamily}"
                                  Foreground="White"
                                  HorizontalAlignment="Center"
                                  Text="WpfTemplate" />
                    <ui:TextBlock Margin="0,10,0,0"
                                  FontFamily="{StaticResource AppFontFamily}"
                                  Foreground="#CCFFFFFF"
                                  HorizontalAlignment="Center"
                                  TextAlignment="Center"
                                  TextWrapping="Wrap"
                                  Text="创建账号，开始使用本模板" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Background="{DynamicResource ApplicationBackgroundBrush}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Width="340"
                                Margin="40,48,40,24">
                        <DockPanel LastChildFill="False">
                            <ui:TextBlock FontTypography="Title"
                                          FontFamily="{StaticResource AppFontFamily}"
                                          Text="注册" />
                            <StackPanel DockPanel.Dock="Right"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <ui:HyperlinkButton VerticalAlignment="Center"
                                                    FontFamily="{StaticResource AppFontFamily}"
                                                    Content="{Binding ModeSwitchLabel}"
                                                    Visibility="{Binding ModeSwitchVisibility}"
                                                    Command="{Binding ToggleRegisterModeCommand}" />
                                <ui:TextBlock Margin="6,0"
                                              VerticalAlignment="Center"
                                              FontFamily="{StaticResource AppFontFamily}"
                                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                              Text="·"
                                              Visibility="{Binding ModeSwitchVisibility}" />
                                <ui:HyperlinkButton VerticalAlignment="Center"
                                                    FontFamily="{StaticResource AppFontFamily}"
                                                    Content="已有账号？去登录"
                                                    Command="{Binding GoLoginCommand}" />
                            </StackPanel>
                        </DockPanel>

                        <StackPanel Margin="0,32,0,0" Visibility="{Binding ClosedVisibility}">
                            <ui:TextBlock FontTypography="Subtitle"
                                          FontFamily="{StaticResource AppFontFamily}"
                                          HorizontalAlignment="Center"
                                          Text="暂未开放注册" />
                            <ui:Button Margin="0,20,0,0"
                                       Height="36"
                                       HorizontalAlignment="Stretch"
                                       FontFamily="{StaticResource AppFontFamily}"
                                       Appearance="Primary"
                                       Content="返回登录"
                                       Command="{Binding GoLoginCommand}" />
                        </StackPanel>

                        <StackPanel Visibility="{Binding FormVisibility}">
                            <TabControl x:Name="RegisterTabs"
                                        Margin="0,16,0,0"
                                        Height="44"
                                        Padding="0"
                                        BorderThickness="0"
                                        Background="Transparent"
                                        FontFamily="{StaticResource AppFontFamily}"
                                        Visibility="{Binding OtpTabsVisibility}"
                                        SelectionChanged="RegisterTabs_OnSelectionChanged">
                                <TabItem Header="邮箱"
                                         Tag="EMAIL"
                                         Visibility="{Binding EmailTabVisibility}" />
                                <TabItem Header="手机号"
                                         Tag="PHONE"
                                         Visibility="{Binding PhoneTabVisibility}" />
                            </TabControl>

                            <StackPanel Visibility="{Binding AccountFieldsVisibility}">
                                <ui:TextBox Margin="0,16,0,0"
                                            Height="36"
                                            FontFamily="{StaticResource AppFontFamily}"
                                            PlaceholderText="用户名"
                                            Text="{Binding Account, UpdateSourceTrigger=PropertyChanged}" />
                                <ui:TextBox Margin="0,12,0,0"
                                            Height="36"
                                            FontFamily="{StaticResource AppFontFamily}"
                                            PlaceholderText="邮箱（必填）"
                                            Visibility="{Binding RequireEmailVisibility}"
                                            Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />
                                <ui:TextBox Margin="0,12,0,0"
                                            Height="36"
                                            FontFamily="{StaticResource AppFontFamily}"
                                            PlaceholderText="手机号（必填）"
                                            Visibility="{Binding RequirePhoneVisibility}"
                                            Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Visibility="{Binding EmailFieldsVisibility}">
                                <ui:TextBox Margin="0,16,0,0"
                                            Height="36"
                                            FontFamily="{StaticResource AppFontFamily}"
                                            PlaceholderText="邮箱"
                                            Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Visibility="{Binding PhoneFieldsVisibility}">
                                <ui:TextBox Margin="0,16,0,0"
                                            Height="36"
                                            FontFamily="{StaticResource AppFontFamily}"
                                            PlaceholderText="手机号"
                                            Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <Grid Margin="0,12,0,0"
                                  Height="36"
                                  Visibility="{Binding OtpFieldsVisibility}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBox Grid.Column="0"
                                            Height="36"
                                            FontFamily="{StaticResource AppFontFamily}"
                                            PlaceholderText="请输入验证码"
                                            Text="{Binding OtpCode, UpdateSourceTrigger=PropertyChanged}" />
                                <ui:Button Grid.Column="2"
                                           Height="36"
                                           MinWidth="108"
                                           Padding="12,0"
                                           FontFamily="{StaticResource AppFontFamily}"
                                           Appearance="Secondary"
                                           Content="{Binding SendCodeLabel}"
                                           Command="{Binding SendRegisterCodeCommand}"
                                           IsEnabled="{Binding CanSendCode}" />
                            </Grid>

                            <ui:PasswordBox x:Name="PasswordBox"
                                            Margin="0,12,0,0"
                                            Height="36"
                                            FontFamily="{StaticResource AppFontFamily}"
                                            PlaceholderText="密码"
                                            PasswordChanged="PasswordBox_OnPasswordChanged" />

                            <ui:PasswordBox x:Name="ConfirmPasswordBox"
                                            Margin="0,12,0,0"
                                            Height="36"
                                            FontFamily="{StaticResource AppFontFamily}"
                                            PlaceholderText="确认密码"
                                            PasswordChanged="ConfirmPasswordBox_OnPasswordChanged" />

                            <Grid Margin="0,12,0,0" Height="36">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBox Grid.Column="0"
                                            Height="36"
                                            FontFamily="{StaticResource AppFontFamily}"
                                            PlaceholderText="请输入图形验证码"
                                            Text="{Binding CaptchaValue, UpdateSourceTrigger=PropertyChanged}" />
                                <ui:Button Grid.Column="2"
                                           Height="36"
                                           MinWidth="108"
                                           Padding="8,0"
                                           Appearance="Secondary"
                                           ToolTip="刷新验证码"
                                           Click="CaptchaImage_OnClick">
                                    <Grid>
                                        <Image MaxHeight="28"
                                               Stretch="Uniform"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Source="{Binding CaptchaImage}"
                                               Visibility="{Binding CaptchaImage, Converter={StaticResource NullToVisibility}}" />
                                        <ui:SymbolIcon Symbol="ArrowClockwise24"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Visibility="{Binding CaptchaImage, Converter={StaticResource NullToCollapsed}}" />
                                    </Grid>
                                </ui:Button>
                            </Grid>

                            <ui:InfoBar Margin="0,12,0,0"
                                        IsOpen="True"
                                        IsClosable="False"
                                        Severity="Error"
                                        FontFamily="{StaticResource AppFontFamily}"
                                        Title="{Binding ErrorMessage}"
                                        Visibility="{Binding ErrorMessage, Converter={StaticResource NullOrEmptyToVisibility}}" />

                            <ui:Button Margin="0,12,0,0"
                                       Height="36"
                                       HorizontalAlignment="Stretch"
                                       FontFamily="{StaticResource AppFontFamily}"
                                       Appearance="Primary"
                                       Content="立即注册"
                                       Command="{Binding RegisterCommand}"
                                       IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBool}}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <ui:TitleBar VerticalAlignment="Top"
                     Title=""
                     ShowMaximize="False"
                     Background="Transparent"
                     ButtonsBackground="Transparent" />
    </Grid>
</ui:FluentWindow>
