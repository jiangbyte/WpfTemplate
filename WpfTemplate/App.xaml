<Application x:Class="WpfTemplate.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:pagesVm="clr-namespace:WpfTemplate.ViewModels.Pages"
             xmlns:pages="clr-namespace:WpfTemplate.Views.Pages"
             xmlns:converters="clr-namespace:WpfTemplate.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <!-- 全应用固定中文字体，避免落到西文系统字体 -->
            <FontFamily x:Key="AppFontFamily">Microsoft YaHei UI</FontFamily>

            <Style TargetType="{x:Type Window}">
                <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
            </Style>
            <Style TargetType="{x:Type Control}">
                <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
            </Style>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
            </Style>
            <Style TargetType="{x:Type ui:TextBlock}">
                <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
            </Style>

            <converters:InvertBoolConverter x:Key="InvertBool" />
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <converters:BoolToVisibilityConverter x:Key="BoolToCollapsed" Invert="True" />
            <converters:NullOrEmptyToVisibilityConverter x:Key="NullOrEmptyToVisibility" />
            <converters:NullToVisibilityConverter x:Key="NullToVisibility" />
            <converters:NullToVisibilityConverter x:Key="NullToCollapsed" Invert="True" />
            <converters:EqualityToBoolConverter x:Key="EqualityToBool" />

            <!-- 应用图标：与 Assets/Icons/app.svg 一致 -->
            <DrawingImage x:Key="AppIconDrawing">
                <DrawingImage.Drawing>
                    <DrawingGroup>
                        <GeometryDrawing Brush="#0F6CBD">
                            <GeometryDrawing.Geometry>
                                <RectangleGeometry RadiusX="7" RadiusY="7" Rect="2,2,28,28" />
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                        <GeometryDrawing Brush="#FFFFFF">
                            <GeometryDrawing.Geometry>
                                <EllipseGeometry Center="16,18" RadiusX="3.2" RadiusY="3.2" />
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                        <GeometryDrawing>
                            <GeometryDrawing.Pen>
                                <Pen Brush="#FFFFFF" Thickness="2" StartLineCap="Round" EndLineCap="Round" />
                            </GeometryDrawing.Pen>
                            <GeometryDrawing.Geometry>
                                <PathGeometry Figures="M10.5,14.2 A7.2,7.2 0 0 1 21.5,14.2" />
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                        <GeometryDrawing>
                            <GeometryDrawing.Pen>
                                <Pen Thickness="2" StartLineCap="Round" EndLineCap="Round">
                                    <Pen.Brush>
                                        <SolidColorBrush Color="#FFFFFF" Opacity="0.85" />
                                    </Pen.Brush>
                                </Pen>
                            </GeometryDrawing.Pen>
                            <GeometryDrawing.Geometry>
                                <PathGeometry Figures="M7.5,11 A11.2,11.2 0 0 1 24.5,11" />
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                    </DrawingGroup>
                </DrawingImage.Drawing>
            </DrawingImage>

            <DataTemplate DataType="{x:Type pagesVm:HomeViewModel}">
                <pages:HomeView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type pagesVm:AboutViewModel}">
                <pages:AboutView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
